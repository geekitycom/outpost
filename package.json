{
  "name": "outpost",
  "version": "1.1.2",
  "description": "A folder-based HTTP server that serves static and rendered (HTML/OPML/Markdown) pages per domain. Inspired by Dave Winer's PagePark.",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "docker:build-push": "./scripts/docker-build-push.sh",
    "docker:dry-run": "./scripts/docker-build-push.sh --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "eta": "^4.6.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "marked": "^18.1.1",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
